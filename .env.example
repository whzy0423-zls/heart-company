# ── 生产环境变量（docker compose 自动读取本文件）──
# 复制本文件为 .env 并填入真实值：cp .env.example .env

# JWT 签名密钥：务必换成强随机串
#   生成：openssl rand -hex 32
APP_ENV=production
JWT_SECRET=please-change-me-to-a-long-random-secret

# 后台管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# PostgreSQL（docker compose 内置 db 服务使用）
POSTGRES_USER=nx
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=nx_admin

# 生产跨域白名单。官网/后台和 API 不同源时必须配置，例如：
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
# 可信反向代理 CIDR/IP。只有命中这里的代理来源才会信任 X-Forwarded-For/X-Real-IP。
# docker-compose 默认 nx 网络为 172.28.0.0/24；如改了 compose 网络或外层反代，请同步调整。
TRUSTED_PROXY_CIDRS=172.28.0.0/24

# 阿里云 OSS 文件上传
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 示例：oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=
# 示例：cn-hangzhou
OSS_REGION=
# 可选：CDN 或 bucket 公网访问域名，例如 https://cdn.example.com
OSS_PUBLIC_URL=
OSS_PREFIX=uploads
UPLOAD_MAX_MB=20
# 后端 server 对外可达的根地址（无尾斜杠），例如 https://api.example.com
# 用途：视频生成时把本地存储产生的相对地址（/api/uploads、/api/upload-assets）
# 补全为外部视频网关可拉取的绝对地址。未配置 OSS 而走本地存储时必须填公网域名，
# 否则外部网关无法拉取参考素材。为空时不会从 Host/X-Forwarded-Host 推断，外部网关链路会 fail-closed。
PUBLIC_BASE_URL=

# MiniMax 中文版：人声克隆/文本转语音
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_API_BASE=https://api.minimaxi.com

# 微信小程序登录（留空则启用 dev 登录回退，无需真实凭证即可本地联调）
WECHAT_APPID=
WECHAT_SECRET=
# 仅本地开发可设 true；production 会拒绝启动。
WECHAT_LOGIN_DEV=

# 微信支付 v3（JSAPI）。非生产缺关键项会走 dev 模拟；production 缺关键项会禁用支付。
# 证书建议放到宿主机 ./certs/wxpay/，compose 只读挂载到 /run/secrets/wxpay/。
WXPAY_MCH_ID=
WXPAY_APPID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=/run/secrets/wxpay/apiclient_key.pem
WXPAY_PLATFORM_CERT_PATH=/run/secrets/wxpay/wechatpay_platform.pem
WXPAY_NOTIFY_URL=
# 深度报告单价（分），默认 990 = ￥9.9
WXPAY_REPORT_PRICE_CENTS=990
# 仅本地开发可设 true；production 会拒绝启动。
WXPAY_DEV=

# 向量检索（RAG 语义召回）。Provider 为空则关闭向量化，回退关键词检索。
# 兼容 OpenAI 风格 /v1/embeddings。维度需与数据库 vector(N) 一致（默认 1536）。
EMBEDDING_PROVIDER=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536

# App 手机号登录短信。Provider 留空则启用 dev 模式：验证码直接返回响应，
# 无需真实短信即可本地联调。生产可选 aliyun 或 spug。
SMS_PROVIDER=

# 阿里云短信：SMS_PROVIDER=aliyun 时配置。
SMS_API_KEY=
SMS_API_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=

# Spug 推送助手短信：SMS_PROVIDER=spug 时配置。模板编号属于调用凭证，勿暴露给 App。发送格式为 /sms/{模板编号}?to=手机号&code=验证码&number=10。
SPUG_PUSH_API_BASE=https://push.spug.cc
SPUG_PUSH_TEMPLATE_CODE=
SPUG_PUSH_TEMPLATE_NAME=芯之力
SPUG_PUSH_TIMEOUT_SECONDS=10

# 视频/图片生成网关（New API / OpenAI 兼容）。
# 生产环境只要 VIDEO_API_KEY / IMAGE_API_KEY 非空，就必须显式配置对应 API_BASE；
# VIDEO_API_KEY 非空时还必须配置 PUBLIC_BASE_URL=https://api.example.com，
# 否则外部视频网关无法安全拉取本地相对资源，服务会 fail-closed。
# VIDEO_API_KEY 为密钥，请勿提交真实值。
VIDEO_API_BASE=https://video-api.example.com
VIDEO_API_KEY=
VIDEO_MODEL=video-ds-2.0-fast
VIDEO_TIMEOUT_SECONDS=120
IMAGE_API_BASE=https://image-api.example.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_SECONDS=120

# App ASR 语音识别（OpenAI 兼容）。留空则接口返回不可用。
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-1

# App 推送（JPush）。生产缺少以下配置时，推送会失败关闭而不是假成功。
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
