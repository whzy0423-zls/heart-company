PORT=5320
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SITE_CONFIG_PATH=../../../shared/site-config.json
CORS_ALLOWED_ORIGINS=
# 只有显式配置的可信代理来源才会信任 X-Forwarded-For/X-Real-IP；未配置时按直连 IP 限流。
TRUSTED_PROXY_CIDRS=
# 后端公网根地址（无尾斜杠），例如 https://api.example.com。
# 生产启用视频网关 VIDEO_API_KEY 时必填，用于外部视频网关拉取本地相对资源。
PUBLIC_BASE_URL=

# PostgreSQL 连接串（本地开发示例；容器内由 compose 注入）
DATABASE_URL=postgres://nx:nx@localhost:5432/nx_admin?sslmode=disable

# 微信支付 v3。生产缺少关键项时支付接口会返回不可用。
WXPAY_MCH_ID=
WXPAY_APPID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PLATFORM_CERT_PATH=
WXPAY_NOTIFY_URL=
WXPAY_REPORT_PRICE_CENTS=990

# App 推送（JPush）。生产缺少配置时推送会失败关闭。
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# 保存官网配置后自动重新构建并发布 website-react。
# 留空则关闭自动构建（仅写 JSON，不触发构建）。
BUILD_SCRIPT=../../scripts/build-website.sh
BUILD_TIMEOUT_SECONDS=600
# build-website.sh 读取的发布目标（nginx root）；按需覆盖：
# WEBSITE_PUBLISH_DIR=/usr/share/nginx/html
# WEBSITE_DIR=../../../website-react
