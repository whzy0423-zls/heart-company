PORT=5320
# 必须显式配置：dev / test / staging / production。
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SITE_CONFIG_PATH=../../../shared/site-config.json
CORS_ALLOWED_ORIGINS=
# 只有显式配置的可信代理来源才会信任 X-Forwarded-For/X-Real-IP；未配置时按直连 IP 限流。
# docker-compose 默认 nx 网络为 172.28.0.0/24。
TRUSTED_PROXY_CIDRS=172.28.0.0/24
# 后端公网根地址（无尾斜杠），例如 https://api.example.com。
# 生产启用视频网关 VIDEO_API_KEY 时必填，用于外部视频网关拉取本地相对资源。
PUBLIC_BASE_URL=

# 视频/图片网关。生产只要 API_KEY 非空，就必须显式配置对应 API_BASE。
VIDEO_API_BASE=https://video-api.example.com
VIDEO_API_KEY=
VIDEO_MODEL=video-ds-2.0-fast
VIDEO_TIMEOUT_SECONDS=120
IMAGE_API_BASE=https://image-api.example.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_SECONDS=120

# App ASR 语音识别（OpenAI 兼容）。默认使用硅基流动免费模型；ASR_API_KEY 仍需在生产环境填写。
ASR_API_BASE=https://api.siliconflow.cn
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
ASR_TIMEOUT_SECONDS=60

# PostgreSQL 连接串（本地开发示例；容器内由 compose 注入）
DATABASE_URL=postgres://nx:nx@localhost:5432/nx_admin?sslmode=disable

# 微信支付 v3。生产缺少关键项时支付接口会返回不可用。
# compose 建议把证书放到宿主机 ./certs/wxpay/，容器内使用 /run/secrets/wxpay/*.pem。
WXPAY_MCH_ID=
WXPAY_APPID=
WXPAY_API_V3_KEY=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=/run/secrets/wxpay/apiclient_key.pem
WXPAY_PLATFORM_CERT_PATH=/run/secrets/wxpay/wechatpay_platform.pem
WXPAY_NOTIFY_URL=
WXPAY_REPORT_PRICE_CENTS=990

# App 推送（JPush）。生产缺少配置时推送会失败关闭。
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=

# App 手机号登录短信。Provider 留空时仅非生产返回调试验证码；生产可选 aliyun 或 spug。
SMS_PROVIDER=
# 阿里云短信：SMS_PROVIDER=aliyun 时配置。
SMS_API_KEY=
SMS_API_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_ID=
# Spug 推送助手短信：SMS_PROVIDER=spug 时配置。模板编号属于调用凭证，勿暴露给 App。发送格式为 /sms/{模板编号}?to=手机号&code=验证码&number=10。
SPUG_PUSH_API_BASE=https://push.spug.cc
SPUG_PUSH_TEMPLATE_CODE=
SPUG_PUSH_TEMPLATE_NAME=芯之力
SPUG_PUSH_TIMEOUT_SECONDS=10

# 保存官网配置后自动重新构建并发布 website-react。
# 留空则关闭自动构建（仅写 JSON，不触发构建）。
BUILD_SCRIPT=../../scripts/build-website.sh
BUILD_TIMEOUT_SECONDS=600
# build-website.sh 读取的发布目标（nginx root）；按需覆盖：
# WEBSITE_PUBLISH_DIR=/usr/share/nginx/html
# WEBSITE_DIR=../../../website-react
