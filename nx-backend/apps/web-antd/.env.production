VITE_BASE=/
VITE_APP_TITLE=九型芯之力后台
VITE_APP_NAMESPACE=nine-xing-admin-v4
# Vite 变量会进入前端静态产物，这里只能放公开占位值，不能放后端密钥。
VITE_APP_STORE_SECURE_KEY=public-build-time-placeholder

# 接口地址：同源 /api，由 nginx 反代到 Go server
VITE_GLOB_API_URL=/api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
